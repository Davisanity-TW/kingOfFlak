{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "king-of-flak-scores",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://davisanity-tw.github.io",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "king-of-flak-scores-pc",
      "database_id": "278224e1-0244-4034-853c-2452c3ce11c3",
      "migrations_dir": "server/migrations",
    },
    {
      "binding": "MOBILE_DB",
      "database_name": "king-of-flak-scores-mb",
      "database_id": "e9605958-8b12-4fe6-9b8f-08ff244830d7",
      "migrations_dir": "server/migrations",
    },
  ],
  "env": {
    "local": {
      "vars": {
        "ALLOWED_ORIGINS": "http://127.0.0.1:5174",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "king-of-flak-scores-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "server/migrations",
        },
        {
          "binding": "MOBILE_DB",
          "database_name": "king-of-flak-scores-local-mb",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "server/migrations",
        },
      ],
    },
    "test": {
      "name": "king-of-flak-scores-test",
      "vars": {
        "ALLOWED_ORIGINS": "https://davisanity-tw.github.io,http://127.0.0.1:5174,http://127.0.0.1:8791",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "king-of-flak-scores-test",
          "database_id": "3d029357-d05b-49b2-ad9d-8648297ee72c",
          "migrations_dir": "server/migrations",
        },
        {
          "binding": "MOBILE_DB",
          "database_name": "king-of-flak-scores-test-mb",
          "database_id": "e6e3bd38-cebb-47c8-8965-59704b3c9fe0",
          "migrations_dir": "server/migrations",
        },
      ],
    },
  },
}
