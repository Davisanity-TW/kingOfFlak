{
  "name": "king-of-flak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests index.html package.json tsconfig.json playwright.config.ts server wrangler.jsonc",
    "format:check": "prettier --check src tests index.html package.json tsconfig.json playwright.config.ts server wrangler.jsonc",
    "test:unit": "node --test tests/game.test.ts tests/nickname.test.ts tests/leaderboard.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:performance": "FLAK_PERFORMANCE=1 playwright test --project=chrome",
    "api:dev": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "api:migrate:local": "wrangler d1 migrations apply king-of-flak-scores-local --local --env local",
    "api:deploy": "wrangler deploy --env=\"\"",
    "test:api": "node --test tests/api.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.158.0"
  }
}
